# Conexão com o banco de dados Neon Postgres (Serverless)
# Obtenha a connection string no painel do Neon (https://console.neon.tech)
DATABASE_URL="postgresql://user:password@endpoint.region.aws.neon.tech/neondb?sslmode=require"
NEON_DATABASE_URL="postgresql://user:password@endpoint.region.aws.neon.tech/neondb?sslmode=require"

# Meta Pixel (público) e Conversions API (segredo, só no servidor)
NEXT_PUBLIC_META_PIXEL_ID="979841341182458"
META_PIXEL_ID="979841341182458"
META_CAPI_TOKEN="your_meta_conversions_api_access_token_here"

# WhatsApp (formato internacional, só dígitos, ex: 351912345678).
# Enquanto estiver vazio, os botões de WhatsApp não são apresentados.
NEXT_PUBLIC_WHATSAPP_NUMBER=""
